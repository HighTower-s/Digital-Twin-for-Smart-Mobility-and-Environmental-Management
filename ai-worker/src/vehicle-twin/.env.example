# ปลายทางสตรีมเข้า pipeline จริง (backend -> WebSocket -> Unity)
BACKEND_URL=http://localhost:3000
CAMERA_ID=cam-chalongkrung-01

# จำนวนเฟรมที่ส่งเข้า backend ต่อวินาที (ส่งถี่ต่ำ = server เบา, Unity เดาช่วงกลางด้วย Lerp)
STREAM_HZ=2

# business rule: ทิ้ง detection ที่ confidence < 0.5
CONFIDENCE_THRESHOLD=0.5

# โมเดล YOLO — yolov8n.pt เร็วสุด/อ่อนวัตถุเล็ก; yolov8s.pt หรือ m ดักมอไซค์ได้ดีขึ้น (ช้าลง)
YOLO_MODEL=yolov8n.pt

# ---- ความเร็วรถ (โหมด count-event) — กำหนดตามชนิด km/h ----
# ไม่ใช้ความเร็วจาก pixel/homography แล้ว (เพี้ยน) รถแต่ละคันจะได้ค่านี้ ±15% jitter
SPEED_BY_TYPE=car:40,motorcycle:45,truck:35

# ---- ถนน (local frame) — SINGLE SOURCE OF TRUTH ต้องตรงกับ TrafficOriginGizmo ในซีน Unity ----
# รถเกิดที่ START วิ่งไป END; ค่าพวกนี้เป็น "พิกัด local ของถนน" ไม่ใช่ world
# ตำแหน่ง/ทิศจริงใน Unity กำหนดด้วย TrafficOrigin (anchor) — ย้าย/หมุน object นั้นเอา
# ค่าเริ่มต้น = วิ่งตรงตาม +Z ยาว 200 ม. (แนะนำไม่ต้องแก้ ให้ไปจัดที่ anchor ใน Unity แทน)
ROAD_START_X=0      # จุดสปอน x (local)
ROAD_START_Z=0      # จุดสปอน z (local)
ROAD_END_X=0        # ปลายถนน x (local)
ROAD_END_Z=200      # ปลายถนน z (local) = ความยาวถนน (ROAD_LEN) ให้ตรง gizmo.roadLen
# เลน = ระยะเยื้อง "ตั้งฉาก" กับถนน (- ซ้าย / + ขวา) — ต้องตรง gizmo.lanes เป๊ะ
LANES=-3.5,0,3.5
LANE_HALF_WIDTH=1.6   # ต้องตรง gizmo.laneHalfWidth
MIN_GAP=7             # ระยะขั้นต่ำหน้า-หลังในเลนเดียวกัน (กันรถซ้อน)

# ---- แมป x(pixel) ที่เส้นนับ -> เลน + โฟกัสฝั่งเดียว (ต่อคลิป) ----
# ใส่ค่า x ของเส้นแบ่งเลน "เฉพาะฝั่ง/ทิศที่จะทำ" len = จำนวนเลน+1 (วัดที่ระดับเส้น A)
#   เช่นฝั่งหน้า 3 เลน: LANE_X_BOUNDS=760,900,1040,1180  -> ได้ L0/L1/L2
# สำคัญ: รถที่ x นอกช่วง [ค่าแรก..ค่าสุดท้าย] = อีกฝั่ง จะถูก "ข้าม" (ไม่นับ/ไม่ spawn/ไม่ตีกรอบ)
#        อยากทำอีกฝั่ง = เปลี่ยน LANE_X_BOUNDS เป็นช่วงของฝั่งนั้น แล้วรันใหม่
LANE_X_BOUNDS=
ROAD_X_MIN=0         # ใช้ตอน LANE_X_BOUNDS ว่าง: ขอบซ้าย-ขวาของถนนในภาพ (pixel)
ROAD_X_MAX=1920
