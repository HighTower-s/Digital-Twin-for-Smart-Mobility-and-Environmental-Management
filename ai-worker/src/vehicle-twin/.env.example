# ปลายทางสตรีมเข้า pipeline จริง (backend -> WebSocket -> Unity)
BACKEND_URL=http://localhost:3000
CAMERA_ID=cam-chalongkrung-01

# จำนวนเฟรมที่ส่งเข้า backend ต่อวินาที (ส่งถี่ต่ำ = server เบา, Unity เดาช่วงกลางด้วย Lerp)
STREAM_HZ=2

# business rule: ทิ้ง detection ที่ confidence < 0.5
CONFIDENCE_THRESHOLD=0.5

# ---- ถนน (โหมดคร่าวๆ 2 เส้น) — ใส่ค่าเอง อ่านพิกัดจาก Unity ----
# รถเกิดที่ START แล้ววิ่งไปหา END  (ทิศ+ความยาวคำนวณจาก 2 จุดนี้ให้เอง)
#   หาค่า: ลาก empty GameObject ไปวางในซีน อ่าน Position.x / Position.z
#   กลับทิศ = สลับค่า START กับ END
ROAD_START_X=-142.78     # จุดสปอน x (world)
ROAD_START_Z=0      # จุดสปอน z (world)
ROAD_END_X=0        # ปลายถนน x
ROAD_END_Z=200      # ปลายถนน z
# เลน = ระยะเยื้อง "ตั้งฉาก" กับถนน (- ซ้าย / + ขวา) ใส่กี่เลนก็ได้
LANES=-3.5,0,3.5
LANE_HALF_WIDTH=1.2
MIN_GAP=7           # ระยะขั้นต่ำหน้า-หลังในเลนเดียวกัน (กันรถซ้อน)
