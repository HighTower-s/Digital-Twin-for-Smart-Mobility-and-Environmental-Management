# ── Environment ──────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Node.js (backend, mock-server) ───────────────────────────────────────────
node_modules/
dist/
*.js.map

# ── Python (ai-worker) ───────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/

# ── Unity ────────────────────────────────────────────────────────────────────
# Generated cache — never commit (can be 1GB+)
unity/digitaltwin/Library/
unity/digitaltwin/Temp/
unity/digitaltwin/Logs/
unity/digitaltwin/obj/
unity/digitaltwin/ExportedObj/

# WebGL build output
unity/digitaltwin/Build/
unity/digitaltwin/Builds/

# Per-user IDE settings
unity/digitaltwin/UserSettings/

# IDE-generated project files (Unity regenerates these)
unity/digitaltwin/*.csproj
unity/digitaltwin/*.sln
unity/digitaltwin/*.suo
unity/digitaltwin/*.user
unity/digitaltwin/*.pidb
unity/digitaltwin/*.booproj
unity/digitaltwin/sysinfo.txt

# Asset store — large vendor assets, install locally
unity/digitaltwin/Assets/asset\ store/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Docker ───────────────────────────────────────────────────────────────────
infra/db/data/

